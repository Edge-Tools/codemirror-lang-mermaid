{
  "name": "@edgetools/codemirror-lang-mermaid",
  "author": "Nathan Vaughn <inspirnathan@gmail.com>",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Mermaid language support for CodeMirror",
  "scripts": {
    "test": "mocha test/test.js",
    "prepare": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edge-Tools/codemirror-lang-mermaid.git"
  },
  "homepage": "https://github.com/Edge-Tools/codemirror-lang-mermaid#readme",
  "bugs": {
    "url": "https://github.com/Edge-Tools/codemirror-lang-mermaid/issues"
  },
  "keywords": [
    "codemirror",
    "mermaid",
    "lezer"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "mocha": "^9.0.1",
    "rollup": "^2.60.2",
    "rollup-plugin-dts": "^4.0.1",
    "rollup-plugin-ts": "^3.0.2",
    "typescript": "^4.3.4"
  },
  "license": "MIT"
}
